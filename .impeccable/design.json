  "narrative": {
    "northStar": "The Terminal Hearth",
    "overview": "The warmth here is made of code. The left side of the screen is a living ASCII tree: a 3D point cloud drawn as monospace characters, with a soft glow behind it. The right side is a narrow column of text. Everything is small and set in the system typeface. The column sits on the same espresso background as the tree, with no boxes around it, so the text reads like notes left beside a fire. Switch the season and the room turns into a bright beach afternoon. The whole page changes over, but the column stays put and keeps the same rules.\n\nThe text side is precise and understated: one typeface family, one size (15px), hierarchy from brightness rather than size, small monospace labels, and exact spacing with nothing for decoration. All the expression belongs to the tree. The column's job is to be quietly legible while the tree is the thing you look at.",
    "keyCharacteristics": [
      "The page is two layers. A fixed full-viewport canvas (the tree) sits behind a text column that scrolls on the right.",
      "Hierarchy is luminance. Strong, text and dim levels at one size, with no type scale beyond the 26px name.",
      "One mono voice for labels. The nav, hints, meta and footer are all 12px monospace.",
      "Completely flat. There are no boxes, borders or shadows on the text side.",
      "Two complete themes. Winter (espresso) and summer (beach towel blue) swap every neutral.",
      "Colour is borrowed. It appears in the text only when a card's ornament lights up on the tree."
    ],
    "rules": [
      {
        "name": "The Tree Owns Colour Rule",
        "body": "The text column is neutral. Saturated colour appears there only when a card's matching ornament lights up: the card title takes `--accent` when the card is lit from the tree, hovered with a mouse, or holds focus. Don't add accent colours to links, keys, buttons or backgrounds.",
        "section": "colors"
      },
      {
        "name": "The Whole-Season Rule",
        "body": "Every neutral has a summer counterpart. A new colour is incomplete until it's defined under both `:root` and `:root[data-theme=\"summer\"]`.",
        "section": "colors"
      },
      {
        "name": "The One Size Rule",
        "body": "Everything except the name is 15px. Rank comes from weight (600 vs 400) and luminance (strong, text, dim), never from a bigger font.",
        "section": "typography"
      },
      {
        "name": "The Lowercase Mono Rule",
        "body": "Labels are 12px monospace and lowercase. They are never uppercase or letter-spaced.",
        "section": "typography"
      },
      {
        "name": "The Flat Column Rule",
        "body": "Nothing on the text side gets a box, border, background panel or shadow. If something needs separating, use spacing or luminance.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep every new token paired across winter and summer.",
      "Do rank text by luminance (Cream, Parchment, Driftwood) at 15px. Only the name is larger (26px).",
      "Do use 12px lowercase monospace for any label, meta or hint.",
      "Do give every new section a `data-tree` object and a `.key` naming it, e.g. \"(presents)\". Give it a summer wording too.",
      "Do keep the Cream focus outline on everything focusable, and remove motion under `prefers-reduced-motion`.",
      "Do name each section once and reuse that word in the nav, heading and tooltip."
    ],
    "donts": [
      "Don't put boxes, borders, panels or shadows on the text column.",
      "Don't use ornament colours anywhere in the text except a lit, hovered or focused card title.",
      "Don't make an element a tab stop unless it does something.",
      "Don't add a heading size between 15px and 26px, or uppercase or letter-spaced labels.",
      "Don't let content cover or block the tree on desktop. The column stays right of the gutter and ignores pointer events between items."
    ]
  }
}